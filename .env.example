# 【Stage 8C】環境は2つに分ける。値は実値を書かない（このファイルはダミーのみ。Git管理）。
#   .env.local            … 開発用。ローカルSupabase（Docker）の値だけ。npm run db:up && npm run db:env で自動生成される。本番の鍵は入れない。
#   .env.production-ops   … 本番の設定（本番Supabase・service_role・バックアップ用パスフレーズ等）。npm run prod / backup:* / verify:prod だけが読む。Git管理外。
#   Vercel の環境変数      … 本番アプリの設定（Preview・Development には何も設定していない＝プレビューは本番DBに繋がらない）
# 手順の全体は docs/DEV_ENVIRONMENT.md。
# 開発用の印。ローカル用の設定であることを示し、アプリは本番のSupabaseへの接続を拒否する（db:env が自動で書く）。Vercelには設定しない
TOREMANE_ENV=

# .env.local にコピーして使う（.env.local は git 管理外）。mock なら Supabase 不要。
# 秘密鍵（service_role、Web Push秘密鍵）はここへ実値を書かず、Vercel/ローカルの環境変数のみで管理する。

# データ層の切替: "mock"（認証なし・架空データのみ）/ "supabase"（共通ログイン＋実プロフィール＋マスターDB。抽選本体はStage 2までデモデータ）
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase（トレカ専用の別プロジェクト。家計簿のものを流用しない）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用。NEXT_PUBLIC_ を付けない
SUPABASE_SERVICE_ROLE_KEY=

# Web Push（Stage 3）。秘密鍵はサーバー専用
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Push送信者の連絡先（mailto: または https://）。個人のメールアドレスは入れない
VAPID_SUBJECT=
# 通知ジョブ(/api/cron/notify)の認証用。十分長いランダム文字列（サーバー専用。Vercelの環境変数にも同じ値を設定）
CRON_SECRET=

# AI読み取り（Stage 4B・任意）。未設定でも画面は動作し、「AIで読み取る」は設定の案内を表示する。サーバー専用（NEXT_PUBLIC_ を付けない）
ANTHROPIC_API_KEY=
# 使うモデル（省略時 claude-haiku-5-5。精度が足りなければ claude-sonnet-5-5）
AI_MODEL=
# 開発・テスト専用: mock を指定すると固定のサンプルを返す（実際のAI解析ではない）。本番には設定しない
AI_PROVIDER=
# 費用の上限（世帯あたりの回数。省略時 1時間20回 / 1日60回）
AI_HOURLY_LIMIT=
AI_DAILY_LIMIT=

# 抽選情報の自動収集（Stage 4C・任意）。X公式APIのBearerトークン。サーバー専用（NEXT_PUBLIC_ を付けない）。
# 未設定でもWebサイトの収集は使える。設定しても、設定画面で「X公式APIを使う」と月額予算を設定するまでAPIは呼ばない（従量課金）。
X_BEARER_TOKEN=

# Xブックマーク連携（Stage 6I・任意）。OAuth 2.0 (PKCE)。サーバー専用（NEXT_PUBLIC_ を付けない）。未設定なら連携ボタンは使えない
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# トークンの暗号化キー（AES-256-GCM）。base64の32バイト: openssl rand -base64 32 。紛失・変更すると保存済みトークンが読めなくなり再連携が必要
X_OAUTH_ENCRYPTION_KEY=
# コールバックURL（省略時 https://toreca-app.vercel.app/api/x/oauth/callback）
X_OAUTH_REDIRECT_URI=
