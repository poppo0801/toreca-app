# .env.local にコピーして使う（.env.local は git 管理外）。mock なら Supabase 不要。
# 秘密鍵（service_role、Web Push秘密鍵）はここへ実値を書かず、Vercel/ローカルの環境変数のみで管理する。

# データ層の切替: "mock"（認証なし・架空データのみ）/ "supabase"（共通ログイン＋実プロフィール＋マスターDB。抽選本体はStage 2までデモデータ）
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase（トレカ専用の別プロジェクト。家計簿のものを流用しない）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用。NEXT_PUBLIC_ を付けない
SUPABASE_SERVICE_ROLE_KEY=

# Web Push（Stage 3）。秘密鍵はサーバー専用
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Push送信者の連絡先（mailto: または https://）。個人のメールアドレスは入れない
VAPID_SUBJECT=
# 通知ジョブ(/api/cron/notify)の認証用。十分長いランダム文字列（サーバー専用。Vercelの環境変数にも同じ値を設定）
CRON_SECRET=

# AI読み取り（Stage 4B・任意）。未設定でも画面は動作し、「AIで読み取る」は設定の案内を表示する。サーバー専用（NEXT_PUBLIC_ を付けない）
ANTHROPIC_API_KEY=
# 使うモデル（省略時 claude-sonnet-5-5。費用を抑えるなら claude-haiku-5-5）
AI_MODEL=
# 開発・テスト専用: mock を指定すると固定のサンプルを返す（実際のAI解析ではない）。本番には設定しない
AI_PROVIDER=
# 費用の上限（世帯あたりの回数。省略時 1時間20回 / 1日60回）
AI_HOURLY_LIMIT=
AI_DAILY_LIMIT=
